# Application
APP_ENV=local
APP_NAME=tross-linkedin-profile-api
PORT=8000
PUBLIC_BASE_URL=https://example.invalid
LOG_LEVEL=INFO

# Authentication (digests only; never put a raw evaluator key here)
API_KEY_HASHES=<comma-separated-sha256-or-hmac-digests>
# API_KEY_HMAC_SECRET=<hmac-secret-if-used>

# Redis
REDIS_URL=redis://:<password>@<host>:<port>/<database>
REDIS_SOCKET_TIMEOUT_SECONDS=<positive-seconds>

# Cache and single-flight
CACHE_PROFILE_TTL_SECONDS=<positive-seconds>
# Enable only after Spike 0 proves a deterministic not-found signal.
# CACHE_NEGATIVE_TTL_SECONDS=<positive-seconds>
SINGLEFLIGHT_LOCK_TTL_SECONDS=<positive-seconds>
SINGLEFLIGHT_WAIT_TIMEOUT_SECONDS=<positive-seconds>

# Inbound and upstream safety budgets (local policy, not LinkedIn quotas)
INBOUND_RATE_LIMIT_CAPACITY=<positive-token-count>
INBOUND_RATE_LIMIT_REFILL_PER_SECOND=<positive-token-rate>
UPSTREAM_RATE_LIMIT_CAPACITY=<positive-token-count>
UPSTREAM_RATE_LIMIT_REFILL_PER_SECOND=<positive-token-rate>
UPSTREAM_COOLDOWN_DEFAULT_SECONDS=<positive-seconds>
UPSTREAM_RETRY_AFTER_MAX_SECONDS=<positive-seconds>
MAX_UPSTREAM_CONCURRENCY=<positive-integer>

# HTTP client and retry bounds
HTTPX_MAX_CONNECTIONS=<positive-integer>
HTTPX_MAX_KEEPALIVE_CONNECTIONS=<positive-integer>
HTTPX_KEEPALIVE_EXPIRY_SECONDS=<positive-seconds>
UPSTREAM_CONNECT_TIMEOUT_SECONDS=<positive-seconds>
UPSTREAM_READ_TIMEOUT_SECONDS=<positive-seconds>
UPSTREAM_WRITE_TIMEOUT_SECONDS=<positive-seconds>
UPSTREAM_POOL_TIMEOUT_SECONDS=<positive-seconds>
UPSTREAM_MAX_ATTEMPTS=<positive-integer>
UPSTREAM_RETRY_MAX_SLEEP_SECONDS=<positive-seconds>

# Controlled LinkedIn configuration
LINKEDIN_BASE_URL=https://www.linkedin.com
LINKEDIN_USER_AGENT=<descriptive-user-agent>
# Add session material only after the separately approved Spike 0.
# LINKEDIN_LI_AT=<linkedin-session-cookie>
# LINKEDIN_JSESSIONID=<linkedin-session-cookie>
# LINKEDIN_CSRF_TOKEN=<linkedin-csrf-token>

# Sanitized schema-drift diagnostics only
SCHEMA_DRIFT_SAMPLE_LOGGING=false
